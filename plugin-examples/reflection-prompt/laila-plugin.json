{
  "id": "org.laila.reflection-prompt",
  "name": "Reflection Prompt",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "A short written reflection a student submits inside a lesson, with an optional AI-generated follow-up question.",
  "author": { "name": "LAILA", "url": "https://laila.lacarm.com" },
  "license": "MIT",
  "laila": ">=3.16.0 <4.0.0",
  "server": { "entry": "server/index.cjs" },
  "client": { "entry": "client/plugin.js" },
  "extends": [
    {
      "point": "lecture.block",
      "id": "reflection",
      "label": "Reflection",
      "description": "Ask students to write a short reflection.",
      "icon": "pen-line",
      "component": "ReflectionBlock",
      "editor": "ReflectionEditor",
      "settings": [
        { "key": "prompt", "label": "Prompt", "type": "text", "required": true,
          "default": "What is one thing that changed in your thinking this week?" },
        { "key": "minWords", "label": "Minimum words", "type": "number", "default": 40, "min": 0, "max": 500 },
        { "key": "aiFollowUp", "label": "Ask an AI follow-up question", "type": "boolean", "default": false }
      ]
    }
  ],
  "capabilities": ["store", "db", "http", "events", "llm", "activity-log"],
  "migrations": "migrations"
}
