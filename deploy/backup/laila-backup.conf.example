# ─────────────────────────────────────────────────────────────────────────────
# /etc/laila-backup/laila-backup.conf — per-host backup settings.
#
# Copy this file to /etc/laila-backup/laila-backup.conf and edit. It is sourced
# by every script in deploy/backup/, so it is shell, not ini: no spaces around
# `=`, quote anything with spaces.
#
# This file names paths and hosts only. THE PASSPHRASE IS NOT IN HERE — it lives
# in its own root-only file (PASSFILE) so this one can be read, diffed and
# copy-pasted without leaking the thing that decrypts every backup you own.
#
#   install: sudo install -m 0640 -o root -g root laila-backup.conf /etc/laila-backup/
# ─────────────────────────────────────────────────────────────────────────────

# --- what to back up ---------------------------------------------------------

# The LAILA checkout. `server/.env` and `server/uploads` are found underneath it.
APP_DIR="/srv/laila"

# PostgreSQL database name. Dumped through `sudo -u postgres pg_dump`, i.e. peer
# authentication — no password is stored or passed anywhere.
DB_NAME="laila"

# Refuse to call a dump good if it contains fewer than this many tables with
# data. LAILA's schema has ~85 tables; a dump with 0 is the classic silent
# backup failure, where cron reports success every night for a year and the
# archive turns out to be an empty file the day you need it.
MIN_TABLES=50

# --- where the local copy lives ----------------------------------------------

BACKUP_DIR="/var/backups/laila"

# Retention for the local copy, per tier. The data tier is a few MB, so keeping
# a lot of it is nearly free; uploads are hundreds of MB, so keep fewer.
#   *_DAILY   — how many of the most recent bundles to keep, unconditionally
#   *_MONTHLY — additionally keep the newest bundle of each month, this many
#               months back. This is the part that survives a corruption you
#               do not notice for six weeks.
KEEP_DATA_DAILY=14
KEEP_DATA_MONTHLY=12
KEEP_UPLOADS_DAILY=4
KEEP_UPLOADS_MONTHLY=6

# --- encryption --------------------------------------------------------------

# GPG symmetric (AES256) passphrase, one line, root-only (chmod 0400).
# Generated by install.sh if absent.
#
# ESCROW THIS. A backup you cannot decrypt is not a backup. Put the passphrase
# in a password manager AND somewhere that survives losing the password manager.
# Use a DIFFERENT passphrase on each host, so that compromising one host does
# not hand over the other host's archives too.
PASSFILE="/etc/laila-backup/backup.pass"

# --- off-site copy (scp to a host that is not this one) ----------------------

# Leave OFFSITE_HOST empty to disable the scp route entirely.
# Nothing unencrypted is ever sent: only the .gpg blob leaves the machine, so
# the destination host never needs to be trusted with the contents.
# Set these to a machine that is NOT this one. Give each LAILA host its own
# subdirectory (e.g. LAILA-Backups/<hostname>) so the two hosts' retention
# policies can never delete each other's archives.
OFFSITE_HOST=""                      # e.g. backup.internal.example
OFFSITE_USER="ubuntu"
OFFSITE_DIR="LAILA-Backups/thishost" # relative to the remote user's $HOME
OFFSITE_KEY="/etc/laila-backup/id_ed25519_offsite"
KEEP_OFFSITE_DATA=30
KEEP_OFFSITE_UPLOADS=4

# Politeness: this uplink also carries the live site. scp -l takes kbit/s.
SCP_LIMIT_KBIT=40000

# --- off-site copy 2 (rclone, e.g. Google Drive) -----------------------------

# Optional and independent of the scp route — a second provider means a mistake
# or an account loss at one of them is survivable. Leave empty to disable.
# Configure the remote first with `sudo rclone config` (needs a browser once).
#   RCLONE_REMOTE="gdrive:LAILA-Backups"
RCLONE_REMOTE=""
RCLONE_BWLIMIT="00:00,5M 07:00,2M 22:00,5M"

# --- alerting ----------------------------------------------------------------

# Where laila-backup-audit.sh sends the alarm when a backup goes stale or fails.
# Delivered with LAILA's own SMTP settings, read from $APP_DIR/server/.env, so
# there is nothing extra to configure if the app can already send mail.
# Empty disables mail; the audit still logs and still exits non-zero.
ALERT_EMAIL=""

# How old a bundle may get before the audit calls it stale (hours).
STALE_DATA_HOURS=30
STALE_UPLOADS_HOURS=200
